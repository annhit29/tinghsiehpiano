---
import { NormalizeCSS } from "../styles/normalize";
import { Global } from "@emotion/react";
import { PreviewPng } from "@static/images";
import { Header } from "@modules/Header";
import MetaConfig from "./MetaConfig.astro";

interface Props {
    title: string;
    description: string;
    lang?: string;
    overwritePreview?: string;
}

const { title, description, lang = "en", overwritePreview } = Astro.props;

// Canonical URL for THIS page (its own path), built from the configured `site`.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// hreflang alternates: the same page in each language so Google serves the
// right one per the user's locale. Derive the locale-agnostic path, then
// rebuild it under each language prefix (en lives at the root).
const localeMatch = Astro.url.pathname.match(/^\/(zh-tw|fr)(\/.*)?$/);
const basePath = localeMatch ? localeMatch[2] || "/" : Astro.url.pathname;
const localizedHref = (prefix: string) =>
    new URL(prefix + (basePath === "/" ? "" : basePath), Astro.site).href;
const enHref = new URL(basePath, Astro.site).href;
const alternates = [
    { hreflang: "en", href: enHref },
    { hreflang: "fr", href: localizedHref("/fr") },
    // zh-TW targets Taiwan specifically; bare "zh" is the region-independent
    // fallback so Chinese readers anywhere (HK, SG, Malaysia, overseas) get this page too.
    { hreflang: "zh-TW", href: localizedHref("/zh-tw") },
    { hreflang: "zh", href: localizedHref("/zh-tw") },
    { hreflang: "x-default", href: enHref },
];
---

<!-- 
    This is the main layout for the website.
    It includes the header and the main content.
    It also includes the MetaConfig component to set the metadata for the page.
-->
<!doctype html>
<html lang={lang}>
    <head>
        <MetaConfig
            title={title}
            description={description}
            preview={overwritePreview ? overwritePreview : PreviewPng.src}
        />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL} />
        {
            alternates.map((alt) => (
                <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
            ))
        }
        <Global styles={NormalizeCSS} />

        <script>
            /**
             * Add class to transition "overflow element" on page load to make it prettier
             */
            document.addEventListener("DOMContentLoaded", () => {
                document.body.classList.add("hide-overflow");
            });
        </script>
    </head>
    <body>
        <Header client:load />
        <slot />
    </body>
</html>
