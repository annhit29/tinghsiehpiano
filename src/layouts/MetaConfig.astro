---
import { siteUrl } from "../../astro.config.mjs";

interface Props {
    title: string;
    description: string;
    preview: string;
    noindex?: boolean;
    canonical?: string;
    lang?: string;
}

const { title = 'Default Title', description = 'Default Description', preview = '/default-preview.png', noindex = false, canonical = siteUrl, lang = 'en' } = Astro.props;

// Social platforms (Facebook, X, WhatsApp, LINE, LinkedIn) require an ABSOLUTE
// image URL for the share-preview card. `preview` is a build-relative path
// (/_astro/…), so resolve it against the site origin here. (new URL leaves an
// already-absolute URL untouched.)
const absImage = new URL(preview, siteUrl).href;

// og:url MUST be this page's own URL, not the homepage. Facebook treats og:url
// as the canonical content address: if every page points at the homepage,
// sharing any sub-page (or any language) collapses to the English homepage card.
const pageUrl = canonical;

// Tell Facebook which language THIS page is in (and which others exist), so the
// right localized card is shown. Maps our route langs to Open Graph locale codes.
const ogLocaleMap: Record<string, string> = { en: "en_US", "zh-TW": "zh_TW", fr: "fr_FR" };
const ogLocale = ogLocaleMap[lang] ?? "en_US";
const ogLocaleAlternates = Object.values(ogLocaleMap).filter((l) => l !== ogLocale);

/**
 * keep whole metadata in one place
 */
const metaData = {
    keywords:
        "Wei-Ting Hsieh, Wei-Ting, Wei-Ting Hsieh pianist, Wei-Ting pianist, pianist Wei-Ting Hsieh, 謝維庭, 謝維庭 鋼琴家, 鋼琴家謝維庭, 台灣鋼琴家, 谢维庭, 谢维庭 钢琴家, Taiwanese pianist, classical pianist, concert pianist, pianiste taïwanaise, piano, classical piano, pianist",
    default: {
        url: pageUrl,
        type: "website",
        title: title,
        description: description,
        image: absImage,
    },
    twitter: {
        card: "summary_large_image",
        title: title,
        description: description,
        image: absImage,
        domain: new URL(siteUrl).hostname,
        url: pageUrl,
    },
};

// Person structured data (JSON-LD) — tells Google who this site is about and
// links her official profiles (sameAs) so they're recognised as one identity.
// This powers name searches / the Google knowledge panel.
const personSchema = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Wei-Ting Hsieh",
    alternateName: "謝維庭",
    jobTitle: "Pianist",
    nationality: "Taiwanese",
    url: siteUrl,
    image: absImage,
    sameAs: [
        "https://www.instagram.com/weitingpianist/",
        "https://www.threads.com/@weitingpianist",
        "https://www.facebook.com/pianistweitinghsieh/",
        "https://www.facebook.com/ting.hsieh.79/",
        "https://open.spotify.com/artist/05P8KWbEcJD8NWTUbAfjpn",
        "https://music.apple.com/gb/artist/wei-ting-hsieh/1438982345",
        "https://www.knsclassical.com/artist/wei-ting-hsieh/",
    ],
};

---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- icons -->
<!-- for the website tab icon: -->
<link rel="icon" type="image/x-icon" href="favicon.ico" />

<!-- the following line is not used: -->
<link rel="apple-touch-icon" sizes="48x48" href="/favicon.ico" />

<!-- Other meta important things -->
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="color-scheme" content="light only" />
<meta name="keywords" content={metaData.keywords} />

<meta
    name="robots"
    content={noindex
        ? "noindex, follow"
        : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
/>

<!-- default ones -->
<meta property="url" content={metaData.default.url} />
<meta property="type" content={metaData.default.type} />
<meta property="title" content={metaData.default.title} />
<meta property="description" content={metaData.default.description} />
<meta property="image" content={metaData.default.image as string} />

<!-- open graph ones -->
<meta property="og:url" content={metaData.default.url} />
<meta property="og:type" content={metaData.default.type} />
<meta property="og:title" content={metaData.default.title} />
<meta property="og:description" content={metaData.default.description} />
<meta property="og:image" content={metaData.default.image as string} />
<meta property="og:locale" content={ogLocale} />
{ogLocaleAlternates.map((l) => (
    <meta property="og:locale:alternate" content={l} />
))}

<!-- twitter ones -->
<meta name="twitter:card" content={metaData.twitter.card} />
<meta name="twitter:title" content={metaData.twitter.title} />
<meta name="twitter:description" content={metaData.twitter.description} />
<meta name="twitter:image" content={metaData.twitter.image as string} />
<meta property="twitter:domain" content={metaData.twitter.domain} />
<meta property="twitter:url" content={metaData.twitter.url} />

<!-- Person structured data (JSON-LD) for rich results / knowledge panel -->
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
