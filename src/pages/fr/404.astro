---
import { changeLanguage } from "i18next";
import { ContentSection } from "@modules/ContentSection";
import Layout from "../../layouts/Layout.astro";
import { FadeIn } from "@utils/animations/FadeIn";
import { Button } from "@components/Button";

changeLanguage("fr");
---

<Layout
    title="404 | Page non trouvée"
    description="La page que vous recherchez a peut-être été supprimée, son nom a changé ou elle est temporairement indisponible."
>
    <main class="page-content page-404">
        <ContentSection
            style={{
                maxWidth: "600px",
                margin: "0 auto",
                textAlign: "center",
                display: "flex",
                flexDirection: "column",
                justifyContent: "center",
                alignItems: "center",
                height: "100%",
            }}
        >
            <FadeIn client:visible>
                <h1>Wooops - Soory! 404</h1>
                <p>
                    La page que vous recherchez a peut-être été supprimée, son nom a changé ou elle est temporairement indisponible.
                </p>

                <Button
                    variant="secondary"
                    showIcon={false}
                    link="/"
                    align="center"
                >
                    Go back
                </Button>
            </FadeIn>
        </ContentSection>
    </main>
</Layout>
