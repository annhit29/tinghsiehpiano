---
import { changeLanguage } from "i18next";
import { PianistSlider4 } from "@static/images";
import Layout from "../../layouts/Layout.astro";
import { Contact as ContactModule } from "@modules/Contact";
import { Pianist } from "@modules/Hero";
import { Footer } from "@modules/Footer";

changeLanguage("fr");
---

<!-- todo: add meta description for SEO -->

<Layout
    title="Wei-Ting Pianiste | Contact"
    description="Contacter la pianiste taïwanaise Wei-Ting Hsieh"
    lang="fr"
>
    <main class="page-content">
        <Pianist
            pianistType="ParallaxImage"
            client:load
            data={{
                image: PianistSlider4.src,
                content: {
                    title: "Contact",
                    paragraph:
                        "Contactez-moi !",
                },
            }}
        />

        <ContactModule client:load />
    </main>
    <Footer />
</Layout>
