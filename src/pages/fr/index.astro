---
import { changeLanguage } from "i18next";
import { PianistSlider1, PianistSlider2 } from "@static/images";
import Layout from "../../layouts/Layout.astro";
import { Pianist } from "@modules/Hero";
import { responsiveHero } from "@utils/responsiveHero";

changeLanguage("fr");

const slide1 = await responsiveHero(PianistSlider1);
const slide2 = await responsiveHero(PianistSlider2);
---

<!-- the highest level of the page, the homepage. -->

<Layout
    title="Wei-Ting Hsieh | Pianiste"
    description="Page d'accueil de la pianiste taïwanaise Wei-Ting Hsieh"
    lang="fr"
>
    <main class="page-content">
        <Pianist
            client:load
            pianistType="fullPageSlider"
            data={[
                {
                    subtitle: "Pianiste",
                    title: "Wei-Ting HSIEH",
                    background: slide1.src,
                    backgroundSrcSet: slide1.srcSet,
                    // paragraph:
                    //     "",
                    button: {
                        text: "Wei-Ting",
                        link: "/fr/biography",
                    },
                },
                {
                    subtitle: "Pianiste",
                    title: "Wei-Ting HSIEH",
                    background: slide2.src,
                    backgroundSrcSet: slide2.srcSet,
                    paragraph: "Bonne écoute",
                    button: {
                        text: "Écouter",
                        link: "/fr/music",
                    },
                },
            ]}
        />
    </main>
</Layout>
