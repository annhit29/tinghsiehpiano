---
import { changeLanguage } from "i18next";
import { PianistSlider1, PianistSlider2 } from "@static/images";
import Layout from "../../layouts/Layout.astro";
import { Pianist } from "@modules/Hero";

changeLanguage("fr");
---

<!-- the highest level of the page, the homepage. -->

<Layout
    title={Astro.url.pathname.replace(/\/$/, '') === '/' ? 'Wei-Ting Hsieh' : 'Wei-Ting Hsieh'}
    description={Astro.url.pathname.replace(/\/$/, '') === '/' ? 'Homepage of Taiwanese Pianist Wei-Ting Hsieh' : 'Homepage of Taiwanese Pianist Wei-Ting Hsieh'}
>
    <main class="page-content">
        <Pianist
            client:load
            pianistType="fullPageSlider"
            data={[
                {
                    subtitle: "Pianiste",
                    title: "Wei-Ting HSIEH",
                    background: PianistSlider1.src,
                    // paragraph:
                    //     "",
                    button: {
                        text: "Wei-Ting",
                        link: "/fr/biography",
                    },
                },
                {
                    subtitle: "Pianiste",
                    title: "Wei-Ting HSIEH",
                    background: PianistSlider2.src,
                    paragraph: "Bonne écoute",
                    button: {
                        text: "Écouter",
                        link: "/fr/music",
                    },
                },
            ]}
        />
    </main>
</Layout>
