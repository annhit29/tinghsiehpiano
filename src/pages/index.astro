---
import { changeLanguage } from "i18next";
import { PianistSlider1, PianistSlider2 } from "@static/images";
import Layout from "../layouts/Layout.astro";
import { Pianist } from "@modules/Hero";

changeLanguage("en");
---

<!-- the highest level of the page, the homepage. -->

<!-- Languages live in src/locales/config.ts. EN/FR/zh-TW are live; to add DE/KR etc.:
     1) add an entry to LOCALES, 2) create src/locales/<code>/*.json,
     3) copy this src/pages/<code>/ folder, 4) register the JSON in src/i18n.ts. -->

<Layout
    title="Wei-Ting Hsieh | Pianist"
    description="Homepage of Taiwanese Pianist Wei-Ting Hsieh"
>
    <main class="page-content">
        <Pianist
            client:load
            pianistType="fullPageSlider"
            data={[
                {
                    subtitle: "Pianist",
                    title: "Wei-Ting HSIEH",
                    background: PianistSlider1.src,
                    // paragraph:
                    //     "",
                    button: {
                        text: "Wei-Ting",
                        link: "/biography",
                    },
                },
                {
                    subtitle: "Pianist",
                    title: "Wei-Ting HSIEH",
                    background: PianistSlider2.src,
                    paragraph: "Enjoy the music",
                    button: {
                        text: "Listen",
                        link: "/music",
                    },
                },
            ]}
        />
    </main>
</Layout>
