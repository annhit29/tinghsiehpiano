{
  "extends": "astro/tsconfigs/base",

  "compilerOptions": {
    
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": "src",
    "paths": {
        "@components/*": ["components/*"],
        "@modules/*": ["modules/*"],
        "@styles/*": ["styles/*"],
        "@layouts/*": ["layouts/*"],
        "@pages/*": ["pages/*"],
        "@static/*": ["static/*"],
        "@utils/*": ["utils/*"],
        "@data/*": ["data/*"],
        "@content/*": ["content/*"],
    },
      // look here for our custom i18next augmentations:
    "typeRoots": ["src/@types", "node_modules/@types"]
  },
  // also include that folder so TS actually loads the .d.ts files:
  "include": ["src", "src/@types"]
}
